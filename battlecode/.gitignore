# Generated by `cambc init` (SDK, map pool) and by running matches.
.cambc/
sdk/
cmake/
maps/
replays/
matches/
submissions/
__pycache__/
.pytest_cache/
bots/*/.cambc/
bots/*/build/
bots/*/target/
# Only the competition bot and its frozen baseline are tracked; tuning
# variants, starters and scouts are regenerated on demand.
bots/*
!bots/velvet/
!bots/baseline/
